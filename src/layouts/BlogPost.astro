---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
}

const { title, description, pubDate, updatedDate, tags, category } = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Blog</title>
    <style>
      body { font-family: Georgia, serif; max-width: 720px; margin: 0 auto; padding: 2rem 1rem; line-height: 1.7; color: #222; }
      nav a { color: #555; text-decoration: none; margin-right: 1rem; }
      nav a:hover { color: #000; }
      h1 { font-size: 2rem; margin-top: 2rem; }
      .meta { color: #666; font-size: 0.9rem; margin-bottom: 2rem; }
      .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
      .tag { background: #f0f0f0; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-family: monospace; }
      article { border-top: 1px solid #eee; padding-top: 2rem; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/blog">All Posts</a>
    </nav>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
      {updatedDate && <span> · Updated {formattedUpdatedDate}</span>}
      {category && <span> · {category}</span>}
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
    <article>
      <slot />
    </article>
  </body>
</html>
